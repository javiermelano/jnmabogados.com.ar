---

<section class="contacto section" id="contacto">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Contacto</span>
      <h2 class="section-title">¿Tenés un caso? Hablemos.</h2>
      <p class="section-subtitle">Completá el formulario o escribinos por WhatsApp. La primera consulta es sin cargo.</p>
    </div>

    <div class="contacto__grid">
      <form class="contacto__form reveal reveal-delay-1" id="contact-form">
        <div class="contacto__field">
          <label for="nombre" class="contacto__label">Nombre completo</label>
          <input type="text" id="nombre" name="nombre" class="contacto__input" placeholder="Tu nombre" required />
        </div>
        <div class="contacto__row">
          <div class="contacto__field">
            <label for="telefono" class="contacto__label">Teléfono</label>
            <input type="tel" id="telefono" name="telefono" class="contacto__input" placeholder="Tu teléfono" required />
          </div>
          <div class="contacto__field">
            <label for="email" class="contacto__label">Email (Opcional)</label>
            <input type="email" id="email" name="email" class="contacto__input" placeholder="tu@email.com" />
          </div>
        </div>
        <div class="contacto__field">
          <label for="asunto" class="contacto__label">Tipo de consulta</label>
          <select id="asunto" name="asunto" class="contacto__input contacto__select">
            <option value="">Seleccioná una opción</option>
            <option value="transito">Accidente de tránsito</option>
            <option value="trabajo">Accidente de trabajo</option>
            <option value="sucesorio">Derecho sucesorio</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div class="contacto__field">
          <label for="mensaje" class="contacto__label">Contanos tu caso</label>
          <textarea id="mensaje" name="mensaje" class="contacto__input contacto__textarea" placeholder="Describí brevemente lo que te pasó..." rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn--primary btn--lg contacto__submit">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Enviar consulta
        </button>
      </form>

      <div class="contacto__info reveal reveal-delay-2">
        <div class="contacto__info-card">
          <h3 class="contacto__info-title">Contacto directo</h3>
          <p class="contacto__info-text">Escribinos por WhatsApp y te respondemos a la brevedad.</p>
          <a href="https://wa.me/5491151345587?text=Hola%2C%20vengo%20desde%20la%20web.%20Quiero%20hacer%20una%20consulta." target="_blank" rel="noopener" class="btn btn--whatsapp btn--lg contacto__whatsapp">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Consultar por WhatsApp
          </a>
        </div>

        <div class="contacto__details">
          <div class="contacto__detail">
            <div class="contacto__detail-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <span class="contacto__detail-label">WhatsApp</span>
              <span class="contacto__detail-value">+54 9 11 5134 5587</span>
            </div>
          </div>
          <div class="contacto__detail">
            <div class="contacto__detail-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <div>
              <span class="contacto__detail-label">Instagram</span>
              <span class="contacto__detail-value">@jnmabogados</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ... (mismos estilos, pero actualizados para la grid de contacto) ... */
.contacto { background: var(--neutral-50); }
.contacto__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-3xl); align-items: start; }
.contacto__form {
  background: var(--white); padding: var(--space-2xl); border-radius: var(--radius-lg);
  border: 1px solid var(--neutral-200); box-shadow: var(--shadow-md);
}
.contacto__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
.contacto__field { margin-bottom: var(--space-lg); }
.contacto__label { display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-primary); margin-bottom: var(--space-sm); }
.contacto__input {
  width: 100%; padding: 0.875rem 1rem; font-size: var(--text-sm); font-family: var(--font-body);
  border: 1.5px solid var(--neutral-200); border-radius: var(--radius-md); background: var(--neutral-50);
  color: var(--text-primary); transition: all var(--transition-fast); outline: none;
}
.contacto__input:focus { border-color: var(--primary); background: var(--white); box-shadow: 0 0 0 3px rgba(3,100,151,0.1); }
.contacto__input::placeholder { color: var(--neutral-500); }
.contacto__select { cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%236B7B8D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 1rem center; }
.contacto__textarea { resize: vertical; min-height: 120px; }
.contacto__submit { width: 100%; margin-top: var(--space-sm); }
.contacto__info { display: flex; flex-direction: column; gap: var(--space-xl); }
.contacto__info-card {
  background: var(--primary-dark); padding: var(--space-2xl); border-radius: var(--radius-lg);
  color: var(--white); position: relative; overflow: hidden;
}
.contacto__info-title { font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--space-sm); position: relative; }
.contacto__info-text { font-size: var(--text-sm); color: rgba(255,255,255,0.7); line-height: 1.7; margin-bottom: var(--space-xl); position: relative; }
.contacto__whatsapp { width: 100%; position: relative; }
.contacto__details {
  background: var(--white); padding: var(--space-xl); border-radius: var(--radius-lg);
  border: 1px solid var(--neutral-200); display: flex; flex-direction: column; gap: var(--space-lg);
}
.contacto__detail { display: flex; align-items: center; gap: var(--space-md); }
.contacto__detail-icon {
  width: 44px; height: 44px; border-radius: var(--radius-md); flex-shrink: 0;
  background: linear-gradient(135deg, rgba(3,100,151,0.08), rgba(46,170,220,0.08));
  display: flex; align-items: center; justify-content: center; color: var(--primary);
}
.contacto__detail-label { display: block; font-size: var(--text-xs); color: var(--neutral-500); font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
.contacto__detail-value { display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-primary); }
@media (max-width: 768px) {
  .contacto__grid { grid-template-columns: 1fr; }
  .contacto__row { grid-template-columns: 1fr; }
}
</style>
